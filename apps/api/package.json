{
  "name": "@rdrvms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "predev": "npm run prisma:generate",
    "dev": "tsx watch src/server.ts",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prebuild": "npm run prisma:generate",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:integration": "npm run prisma:generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
